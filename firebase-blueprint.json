{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and profile details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "description": "User career tryout sessions, answers, personalized roadmaps, and milestone progress",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "selectedCareerId": { "type": "string" },
        "sessions": { "type": "object" },
        "roadmap": { "type": "object" },
        "checklist": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profile"
    },
    "/users/{userId}/progress/{progressId}": {
      "schema": "UserProgress",
      "description": "Stores user career tryout progress, roadmap and checklist"
    }
  }
}
